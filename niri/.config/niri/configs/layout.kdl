layout {
    gaps 16
    center-focused-column "never" 
    background-color "transparent"

    preset-column-widths {
        proportion 0.3
        proportion 0.5
        proportion 0.6
    }
    focus-ring {
				off	
        width 2
        active-color "#8a6a52"
        inactive-color "#505050"
    }
}
