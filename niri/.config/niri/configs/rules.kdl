window-rule {
  match app-id=r#"zen-browser$"# title="^Picture-in-Picture$"
  open-floating true 
}

window-rule {
  match app-id=r#"love$"# 
  open-floating true
}

window-rule {
  geometry-corner-radius 5
  clip-to-geometry true
  draw-border-with-background false
}

layer-rule {
    place-within-backdrop true
}

